{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run emTasks",
      "type": "shell",
      "command": "cargo run",
      "options": {
        "cwd": "${workspaceFolder}/emtasks"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Test emTasks",
      "type": "shell",
      "command": "cargo test",
      "options": {
        "cwd": "${workspaceFolder}/emtasks"
      },
      "group": "test",
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}
